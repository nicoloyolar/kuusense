rules_version = '2';

// Data model: packages/kuusense_models/lib/src/models.dart
//
// Who is who:
//  - Admin: staff/{uid} with role 'admin' (created by admin tooling). Creates
//    and edits tutors and children (NNA), links tutors to children and reads
//    the children's private profile (nickname, avatar).
//  - Researcher: staff/{uid} with role 'researcher'. Reads the pseudonymous
//    part of every child and all sessions; never names, never writes.
//  - Tutor: account with an active tutors/{uid} doc, created by an admin.
//    Sees and records only the children whose tutorUids contain them, and
//    registers children of their own. A deactivated tutor sees nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }
    function isStaff() { return signedIn() && exists(docPath('staff', request.auth.uid)); }
    function isAdmin() {
      return isStaff() && get(docPath('staff', request.auth.uid)).data.role == 'admin';
    }
    // Active tutor (a missing `active` field means active).
    function isTutor() {
      return hasAccount() && exists(docPath('tutors', request.auth.uid))
        && get(docPath('tutors', request.auth.uid)).data.get('active', true) == true;
    }
    function isLinked(childId) {
      return isTutor() && request.auth.uid in get(docPath('children', childId)).data.tutorUids;
    }
    function nowMs() { return request.time.toMillis(); }
    // Same alphabet as the app: no 0/O, 1/I.
    function codeChars() { return '[A-HJ-NP-Z2-9]'; }

    // ---------------------------------------------------------------- tutors
    match /tutors/{tutorId} {
      function validTutor(d) {
        return d.keys().hasOnly(['displayName', 'type', 'email', 'active', 'createdAtMs'])
          && d.keys().hasAll(['displayName', 'type', 'createdAtMs'])
          && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 60
          && d.type in ['family', 'teacher', 'therapist']
          && d.get('email', '') is string && d.get('email', '').size() <= 254
          && d.get('active', true) is bool
          && d.createdAtMs is int;
      }
      function isSelf() { return hasAccount() && request.auth.uid == tutorId; }

      // Tutors' names and emails: the tutor and admins (not researchers).
      allow read: if isSelf() || isAdmin();
      // Only admins create tutors (the app has no sign-up).
      allow create: if isAdmin() && validTutor(request.resource.data)
        && request.resource.data.email.size() >= 3
        && request.resource.data.active == true;
      // Admins edit any field but the creation date; an active tutor edits
      // only their own name and type.
      allow update: if validTutor(request.resource.data)
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && (isAdmin() || (isTutor() && isSelf()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'type'])));
      // Account deletion goes through admin tooling (data retention policy).
      allow delete: if false;
    }

    // ---------------------------------------------------------------- staff
    // Managed only with admin tooling (Admin SDK bypasses these rules).
    match /staff/{staffId} {
      allow read: if signedIn() && request.auth.uid == staffId;
      allow write: if false;
    }

    // ---------------------------------------------------------------- children (NNA)
    match /children/{childId} {
      function validChild(d) {
        return d.keys().hasOnly(['code', 'birthYear', 'dunnQuadrant', 'ownerUid', 'tutorUids',
                                 'consentConfirmedAtMs', 'createdAtMs', 'lastInviteCode'])
          && d.keys().hasAll(['code', 'birthYear', 'ownerUid', 'tutorUids',
                              'consentConfirmedAtMs', 'createdAtMs'])
          && d.code is string && d.code.matches('N-' + codeChars() + '{4}')
          && d.birthYear is int && d.birthYear >= 1990 && d.birthYear <= request.time.year()
          && d.get('dunnQuadrant', null) in [null, 'seeking', 'avoiding', 'sensitivity', 'registration']
          && d.tutorUids is list
          && d.consentConfirmedAtMs is int && d.createdAtMs is int;
      }
      function linked() { return isTutor() && request.auth.uid in resource.data.tutorUids; }
      function isOwner() { return signedIn() && request.auth.uid == resource.data.ownerUid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function oldTutors() { return resource.data.tutorUids; }
      function newTutors() { return request.resource.data.tutorUids; }
      function noDuplicates(l) { return l.toSet().size() == l.size(); }

      // A linked tutor edits the research-visible profile.
      function editsProfile() {
        return linked() && changed().hasOnly(['birthYear', 'dunnQuadrant'])
          && validChild(request.resource.data);
      }
      // A tutor other than the owner unlinks themself.
      function leaves() {
        return linked() && !isOwner() && changed().hasOnly(['tutorUids'])
          && noDuplicates(newTutors())
          && newTutors().toSet() == oldTutors().toSet().difference([request.auth.uid].toSet());
      }
      // The owner unlinks other tutors, never themself.
      function ownerUnlinks() {
        return linked() && isOwner() && changed().hasOnly(['tutorUids'])
          && noDuplicates(newTutors())
          && newTutors().hasAll([resource.data.ownerUid])
          && oldTutors().hasAll(newTutors())
          && newTutors().size() < oldTutors().size();
      }
      // A tutor joins with a valid invite, deleting it in the same batch so it
      // cannot be used again.
      function joinsWithInvite() {
        let code = request.resource.data.lastInviteCode;
        let invitePath = docPath('invites', code);
        let invite = get(invitePath).data;
        return isTutor() && !linked()
          && changed().hasOnly(['tutorUids', 'lastInviteCode'])
          && newTutors() == oldTutors().concat([request.auth.uid])
          && invite.childId == childId
          && invite.expiresAtMs > nowMs()
          && !existsAfter(invitePath);
      }

      // An admin edits the profile, the linked tutors and the owner (who must
      // stay linked). Code, consent and creation date never change.
      function adminEdits() {
        return isAdmin()
          && changed().hasOnly(['birthYear', 'dunnQuadrant', 'tutorUids', 'ownerUid'])
          && validChild(request.resource.data)
          && noDuplicates(newTutors())
          && newTutors().hasAll([request.resource.data.ownerUid]);
      }

      // Written against resource.data so `tutorUids array-contains uid` list
      // queries are allowed.
      allow read: if isStaff() || linked();
      // A tutor registers a child as its owner; an admin registers it for an
      // existing tutor.
      allow create: if validChild(request.resource.data)
        && !('lastInviteCode' in request.resource.data)
        && request.resource.data.tutorUids == [request.resource.data.ownerUid]
        && ((isTutor() && request.resource.data.ownerUid == request.auth.uid)
            || (isAdmin() && exists(docPath('tutors', request.resource.data.ownerUid))));
      allow update: if editsProfile() || leaves() || ownerUnlinks() || joinsWithInvite()
        || adminEdits();
      allow delete: if (isTutor() && isOwner()) || isAdmin();

      // Identifying data: linked tutors and admins (never researchers).
      match /private/{docId} {
        function validProfile(d) {
          return docId == 'profile'
            && d.keys().hasOnly(['displayName', 'avatarId'])
            && d.keys().hasAll(['displayName', 'avatarId'])
            && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
            && d.avatarId is string && d.avatarId.size() >= 1 && d.avatarId.size() <= 40;
        }

        allow read: if isLinked(childId) || isAdmin();
        allow update: if (isLinked(childId) || isAdmin()) && validProfile(request.resource.data);
        // getAfter: the child and its profile are created in one batch.
        allow create: if validProfile(request.resource.data)
          && ((isTutor() && request.auth.uid in getAfter(docPath('children', childId)).data.tutorUids)
              || isAdmin());
        // Deleted together with the child (owner or admin).
        allow delete: if isAdmin() || (isTutor()
          && request.auth.uid == get(docPath('children', childId)).data.ownerUid);
      }

      match /sessions/{sessionId} {
        // Context: only kinds (place, activity, tutor types present), no free text.
        function validContext(d) {
          return !('context' in d) || (
            d.context is map
            && d.context.keys().hasOnly(['place', 'activity', 'present'])
            && (!('place' in d.context) || d.context.place == null
                || d.context.place in ['home', 'school', 'therapy', 'other'])
            && (!('activity' in d.context) || d.context.activity == null
                || d.context.activity in ['freePlay', 'classwork', 'meal', 'transition', 'therapy', 'rest', 'other'])
            && (!('present' in d.context) || (d.context.present is list
                && d.context.present.size() <= 3
                && d.context.present.toSet().hasOnly(['family', 'teacher', 'therapist']))));
        }
        // Marked events; per-item shape is checked in the app (rules cannot loop).
        function validEvents(d) {
          return !('events' in d) || (d.events is list && d.events.size() <= 1000);
        }
        // Whole-session figures (SessionStats): numbers only, fixed keys.
        function validStats(d) {
          return !('stats' in d) || d.stats == null || (
            d.stats is map
            && d.stats.keys().hasOnly(['heartRate', 'eda', 'temperature', 'scrCount',
                                       'lossPercent', 'batteryStart', 'batteryEnd']));
        }
        // How the recording ended, and stretches without device data.
        function validEnd(d) {
          return (!('endReason' in d) || d.endReason == null
                  || d.endReason in ['stopped', 'deviceLost', 'appClosed'])
            && (!('gaps' in d) || (d.gaps is list && d.gaps.size() <= 500));
        }
        function validNewSession(d) {
          return d.keys().hasOnly(['childId', 'deviceId', 'createdByUid', 'startedAtMs', 'endedAtMs',
                                   'status', 'packetCount', 'streams', 'files', 'live', 'appVersion',
                                   'context', 'events', 'stats', 'endReason', 'gaps'])
            && validContext(d) && validEvents(d) && validStats(d) && validEnd(d)
            && d.childId == childId
            && d.createdByUid == request.auth.uid
            && d.status == 'recording'
            && d.deviceId is string && d.startedAtMs is int;
        }

        allow read: if isStaff() || isLinked(childId);
        allow create: if isLinked(childId) && validNewSession(request.resource.data);
        // The recording phone updates live values / status / files; it cannot
        // move the session to another child or tutor.
        allow update: if isLinked(childId)
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['live', 'status', 'endedAtMs', 'packetCount', 'streams', 'files',
                         'context', 'events', 'stats', 'endReason', 'gaps'])
          && validContext(request.resource.data) && validEvents(request.resource.data)
          && validStats(request.resource.data) && validEnd(request.resource.data)
          && request.resource.data.status in ['recording', 'uploading', 'uploaded', 'failed'];
        // Research data: deletion goes through admin tooling (retention policy).
        allow delete: if false;
      }
    }

    // Staff read sessions across all children (collection-group query).
    match /{path=**}/sessions/{sessionId} {
      allow read: if isStaff();
    }

    // Admins list every child's private profile (collection-group query).
    match /{path=**}/private/{docId} {
      allow read: if isAdmin();
    }

    // ---------------------------------------------------------------- invites
    match /invites/{code} {
      // Get by exact code only; never list, so codes cannot be enumerated.
      allow get: if isTutor();
      allow list: if false;
      // `create` never overwrites, so an existing code cannot be hijacked.
      allow create: if isTutor()
        && code.matches(codeChars() + '{6}')
        && request.resource.data.keys().hasOnly(['childId', 'createdByUid', 'createdAtMs', 'expiresAtMs'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.childId is string
        && isLinked(request.resource.data.childId)
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > nowMs()
        // 48 h validity plus 5 min of clock skew.
        && request.resource.data.expiresAtMs <= nowMs() + (48 * 60 + 5) * 60 * 1000;
      allow update: if false;
      // Cancelled by a linked tutor, or consumed by the tutor who joins (who is
      // linked once the batch is applied).
      allow delete: if signedIn()
        && request.auth.uid in getAfter(docPath('children', resource.data.childId)).data.tutorUids;
    }
  }
}
